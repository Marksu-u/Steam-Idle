{
  "name": "steam-idle",
  "productName": "SteamIdle",
  "version": "2.0.0",
  "description": "A simple application for idling games on Steam.",
  "license": "MIT",
  "main": "./out/main/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/DevNvll/Steam-Idle.git"
  },
  "homepage": "https://github.com/DevNvll/Steam-Idle",
  "author": {
    "name": "Henrick Mello",
    "email": "devnoir@protonmail.com",
    "url": "DevNvll.github.io"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "clean": "rimraf out dist",
    "dist": "npm run clean && electron-vite build && electron-builder --win --x64",
    "publish": "npm run clean && electron-vite build && electron-builder --win --x64 -p always"
  },
  "build": {
    "win": {
      "icon": "./assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraFiles": [
        "./bin"
      ]
    },
    "nsis": {
      "artifactName": "${name}-setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "electron-updater": "^6.8.9",
    "react": "^18.3.1",
    "react-autosuggest": "^10.1.0",
    "react-dom": "^18.3.1",
    "reactstrap": "^9.2.3",
    "styled-components": "^6.4.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "rimraf": "^6.0.1",
    "vite": "^7.1.0"
  }
}
